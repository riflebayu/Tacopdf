{
  "github": {
    "silent": true
  },
  "rewrites": [
    { "source": "/blog", "destination": "/api/renderBlogIndex" },
    { "source": "/:lang/blog", "destination": "/api/renderBlogIndex" },
    { "source": "/blog/:slug", "destination": "/api/renderArticle" },
    { "source": "/:lang/blog/:slug", "destination": "/api/renderArticle" },
    { "source": "/((?!api/).*)", "destination": "/fallback.html" }
  ]
}