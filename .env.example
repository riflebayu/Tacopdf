# ==========================================
# TACOPDF ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Instructions:
# 1. Copy this file and rename it to `.env` (for local development)
# 2. Fill in the actual values from your Firebase and Vercel consoles.
# 3. DO NOT commit the real `.env` file to version control (ensure it's in .gitignore).
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------
# Firebase Project Configuration
# You can find these values in your Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-your-measurement-id" # Optional (for Google Analytics)

# ------------------------------------------
# BACKEND CONFIGURATION (Vercel Serverless)
# ------------------------------------------
# Gemini AI Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# Note: This variable is NOT prefixed with VITE_ because it should only be accessed 
# by the backend Vercel functions (api/generate.ts) and kept completely hidden from the browser.
GEMINI_API_KEY="your-gemini-api-key"
