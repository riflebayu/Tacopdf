---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Calendar, User, ArrowLeft, Tag } from 'lucide-react';
import { TRANSLATIONS } from '../../../data/translations';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  return allPosts
    .filter(post => !(post.id.startsWith('en/') || post.id.startsWith('en\\'))) // English is handled at the root /blog
    .map(post => {
      const [lang, ...slugParts] = post.id.split(/[\/\\]/);
      const slug = slugParts.join('/').replace('.md', '');

      // Find cluster posts sharing the same translationKey
      let customHreflang: Array<{ lang: string; url: string }> = [];
      if (post.data.translationKey) {
        const clusterPosts = allPosts.filter(p => p.data.translationKey === post.data.translationKey);
        customHreflang = clusterPosts.map(p => {
          const [postLang, ...pSlugParts] = p.id.split(/[\/\\]/);
          const postSlug = pSlugParts.join('/').replace('.md', '');
          return {
            lang: postLang,
            url: postLang === 'en' ? `https://tacopdf.com/blog/${postSlug}` : `https://tacopdf.com/${postLang}/blog/${postSlug}`
          };
        });
      }

      return {
        params: { lang, slug },
        props: { post, customHreflang },
      };
    });
}

const { post, customHreflang = [] } = Astro.props;
const { Content } = await render(post);

const { lang } = Astro.params;
const dict = TRANSLATIONS[lang as keyof typeof TRANSLATIONS] || TRANSLATIONS['en'];

const [, ...slugParts] = post.id.split(/[\/\\]/);
const slug = slugParts.join('/').replace('.md', '');
const canonicalUrl = `https://tacopdf.com/${lang}/blog/${slug}`;
const imageUrl = post.data.featuredImage 
  ? (post.data.featuredImage.startsWith('http') ? post.data.featuredImage : `https://tacopdf.com${post.data.featuredImage}`)
  : 'https://tacopdf.com/favicon-192x192.png';

// [SEO FIX: Dynamic BlogPosting Schema]
const blogSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "image": imageUrl,
  "author": {
    "@type": "Person",
    "name": "Muhammad Bayu Edi",
    "url": "https://www.instagram.com/riflebayu"
  },
  "publisher": {
    "@type": "Organization",
    "name": "TacoPDF",
    "url": "https://tacopdf.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://tacopdf.com/favicon-192x192.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
});
---

<BaseLayout 
  title={`${post.data.title} | TacoPDF`} 
  description={post.data.description} 
  lang={lang}
  author={post.data.author || "Muhammad Bayu Edi"}
  schema={blogSchema}
  image={post.data.featuredImage}
  ogType="article"
  disableHreflang={customHreflang.length <= 1}
  customHreflang={customHreflang}
>
  <article class="min-h-screen bg-background pt-24 pb-20 selection:bg-primary/30">
    <div class="max-w-4xl mx-auto px-6">
      
      {/* Back Button */}
      <a href={`/${lang}/blog`} class="inline-flex items-center gap-2 text-primary hover:text-on-primary-container font-semibold mb-8 transition-colors">
        <ArrowLeft class="w-4 h-4" /> 
        {lang === 'id' ? 'Kembali ke Blog' : 
         lang === 'es' ? 'Volver al Blog' : 
         lang === 'fr' ? 'Retour au Blog' : 
         lang === 'de' ? 'Zurück zum Blog' : 
         lang === 'pt' ? 'Voltar ao Blog' : 
         lang === 'ja' ? 'ブログに戻る' : 
         'Back to Blog'}
      </a>

      {/* Header */}
      <header class="mb-8 md:mb-12">
        {/* 1. Main Title */}
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-on-surface mb-6 leading-tight">
          {post.data.title}
        </h1>

        {/* 2. Metadata (Author, Date, Category) */}
        <div class="flex flex-wrap items-center gap-3 text-xs md:text-sm font-medium text-on-surface-variant/80">
          <div class="flex items-center gap-1.5">
            <User size={13} class="shrink-0 text-primary/70 inline-block" />
            <span>{post.data.author || "Muhammad Bayu Edi"}</span>
          </div>
          <span class="text-on-surface-variant/30">•</span>
          <div class="flex items-center gap-1.5">
            <Calendar size={13} class="shrink-0 text-primary/70 inline-block" />
            <time dateTime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })}
            </time>
          </div>
          {post.data.tags && post.data.tags.length > 0 && (
            <>
              <span class="text-on-surface-variant/30">•</span>
              <div class="flex items-center gap-1.5 text-primary">
                <Tag size={13} class="shrink-0 inline-block" />
                <span class="uppercase tracking-wider font-semibold">{post.data.tags[0]}</span>
              </div>
            </>
          )}
        </div>
      </header>

      {/* Featured Image */}
      {post.data.featuredImage && (
        <div class="relative w-full rounded-xl md:rounded-3xl mb-8 md:mb-16 shadow-2xl border border-outline flex justify-center bg-surface-container-lowest">
          <img 
            src={post.data.featuredImage} 
            alt={post.data.imageAlt || post.data.title}
            class="w-full h-auto object-contain rounded-xl md:rounded-3xl max-h-[600px]"
          />
        </div>
      )}

      {/* Markdown Content */}
      <article class="prose max-w-none mx-auto lg:prose-lg dark:prose-invert prose-img:rounded-xl prose-img:w-full prose-img:h-auto prose-img:object-contain">
        <Content />
      </article>

      {/* Tags Footer Section */}
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-outline-variant/30">
          <div class="flex items-center gap-2 mb-3 text-sm font-semibold text-on-surface-variant">
            <Tag class="w-4 h-4 text-primary" />
            <span>
              {lang === 'id' ? 'Topik Terkait:' : 
               lang === 'es' ? 'Temas Relacionados:' : 
               lang === 'fr' ? 'Sujets Connexes:' : 
               lang === 'de' ? 'Verwandte Themen:' : 
               lang === 'pt' ? 'Tópicos Relacionados:' : 
               lang === 'ja' ? '関連トピック:' : 
               'Related Topics:'}
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="bg-surface-container-high border border-outline-variant px-3 py-1.5 rounded-xl text-xs font-medium text-on-surface hover:border-primary/50 transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

    </div>
  </article>
</BaseLayout>
