---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '404 - Page Not Found | TacoPDF';
const description = 'The page you are looking for does not exist or has been moved. Explore our free online PDF tools.';

const popularTools = [
  { 
    name: 'Merge PDF', 
    slug: 'merge-pdf', 
    desc: 'Combine multiple PDFs into one single document.',
    svg: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>'
  },
  { 
    name: 'Split PDF', 
    slug: 'split-pdf', 
    desc: 'Separate pages into individual PDF files easily.',
    svg: '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" x2="8.12" y1="4" y2="15.88"/><line x1="14.47" x2="20" y1="14.48" y2="20"/><line x1="8.12" x2="12" y1="8.12" y2="12"/>'
  },
  { 
    name: 'Compress PDF', 
    slug: 'compress-pdf', 
    desc: 'Reduce PDF file size without sacrificing quality.',
    svg: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M10 12h4"/><path d="M10 15h4"/>'
  },
  { 
    name: 'PDF to Image', 
    slug: 'pdf-to-image', 
    desc: 'Convert PDF pages into high quality images.',
    svg: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>'
  },
  { 
    name: 'Unlock PDF', 
    slug: 'unlock', 
    desc: 'Remove password protection from encrypted PDFs.',
    svg: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>'
  },
  { 
    name: 'Protect PDF', 
    slug: 'protect', 
    desc: 'Encrypt your PDF with a strong security password.',
    svg: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>'
  },
];
---

<BaseLayout title={title} description={description} lang="en">
  <main class="min-h-[75vh] flex flex-col items-center justify-center px-4 py-12 text-center max-w-4xl mx-auto w-full">
    {/* 404 Image Illustration */}
    <div class="mb-6 max-w-[280px] sm:max-w-[340px] mx-auto filter drop-shadow-md transition-transform hover:scale-105 duration-300">
      <img 
        src="/404 page.png" 
        alt="404 Page Not Found" 
        class="w-full h-auto object-contain mx-auto rounded-2xl"
      />
    </div>

    {/* Message */}
    <h1 class="text-2xl sm:text-4xl font-extrabold text-on-surface mb-3 tracking-tight">
      Page Not Found
    </h1>
    <p class="text-on-surface-variant text-sm sm:text-base max-w-md mb-8 leading-relaxed">
      Oops! The page you are looking for doesn't exist or has been moved to another URL.
    </p>

    {/* Back to Home Button */}
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3.5 bg-primary hover:bg-primary/90 text-on-primary font-bold text-sm rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 mb-14"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      Back to Home
    </a>

    {/* Quick Tools Section */}
    <div class="w-full text-left bg-surface-container/50 border border-outline-variant/40 rounded-2xl p-6 sm:p-8 backdrop-blur-sm shadow-sm">
      <div class="flex items-center gap-2.5 mb-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        <h2 class="text-lg font-bold text-on-surface">
          Popular PDF Tools
        </h2>
      </div>
      <p class="text-xs text-on-surface-variant mb-6">
        Here are some popular tools you might be looking for:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {popularTools.map((tool) => (
          <a
            key={tool.slug}
            href={`/${tool.slug}`}
            class="group flex flex-col p-4 bg-background border border-outline-variant/60 rounded-xl hover:border-primary/50 hover:shadow-md transition-all duration-200"
          >
            <div class="flex items-center gap-3 mb-2">
              <div class="p-2 bg-primary/10 text-primary rounded-lg group-hover:bg-primary group-hover:text-on-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tool.svg} />
              </div>
              <span class="font-bold text-sm text-on-surface group-hover:text-primary transition-colors">
                {tool.name}
              </span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed line-clamp-2">
              {tool.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
