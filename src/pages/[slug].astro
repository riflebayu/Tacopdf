---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkspaceWrapper from '../components/pdf-tools/WorkspaceWrapper';
import TacoIcon from '../components/TacoIcon';
import { ToolSeoArticle } from '../components/ToolSeoArticle';
import { TOOLS, TOOL_ALIASES } from '../data/tools';
import { TRANSLATIONS } from '../data/translations';
import StaticPageClient from '../components/StaticPageClient';
import FAQSection from '../components/FAQSection';

export async function getStaticPaths() {
  const aliases = Object.keys(TOOL_ALIASES || {});
  const ids = (TOOLS || []).map(t => t.id);
  const staticPages = ['privacy', 'terms', 'cookie', 'disclaimer', 'retention', 'how-it-works', 'about', 'contact', 'faq', 'sitemap'];
  const allPaths = Array.from(new Set([...aliases, ...ids, ...staticPages]));
  
  return allPaths.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = 'en';

const staticPagesMap: Record<string, string> = {
  'how-it-works': 'how',
  'about': 'about',
  'contact': 'contact',
  'privacy': 'privacy',
  'terms': 'terms',
  'cookie': 'cookie',
  'disclaimer': 'disclaimer',
  'retention': 'retention'
};

const isStaticPage = staticPagesMap[slug] || ['faq', 'sitemap'].includes(slug);
const pageType = staticPagesMap[slug];
const dict = TRANSLATIONS[lang as keyof typeof TRANSLATIONS] || TRANSLATIONS['en'];

// Tool Logic
const toolId = TOOL_ALIASES?.[slug] || slug;
const tool = TOOLS?.find(t => t.id === toolId);

if (!isStaticPage && !tool) {
  return Astro.redirect('/404');
}

// Data fetching for tool
let translatedName = '';
let translatedDescription = '';
let title = 'TacoPDF';
const howToSteps: string[] = [];
const tips: string[] = [];

if (tool) {
  const toolNameKey = `tool_name.${tool.id.replace(/-/g, '_')}`;
  translatedName = dict[toolNameKey as keyof typeof dict] || TRANSLATIONS['en'][toolNameKey as keyof typeof TRANSLATIONS['en']] || tool.name;

  const descriptionKey = `tools.${tool.id.replace(/-/g, '_')}.description`;
  translatedDescription = dict[descriptionKey as keyof typeof dict] || TRANSLATIONS['en'][descriptionKey as keyof typeof TRANSLATIONS['en']] || tool.description;

  for (let i = 1; i <= 5; i++) {
    const key = `tool.${tool.id.replace(/-/g, '_')}.howto.${i}`;
    const step = dict[key as keyof typeof dict] || TRANSLATIONS['en'][key as keyof typeof TRANSLATIONS['en']];
    if (step && step !== key) howToSteps.push(step);
  }
  if (howToSteps.length === 0) {
    howToSteps.push(
      dict['tool.default.howto.1' as keyof typeof dict] || 'Select the PDF file you wish to process.',
      dict['tool.default.howto.2' as keyof typeof dict] || 'Configure the parameters in the settings panel.',
      dict['tool.default.howto.3' as keyof typeof dict] || 'Click the action button to execute the tool locally.'
    );
  }

  for (let i = 1; i <= 3; i++) {
    const key = `tool.${tool.id.replace(/-/g, '_')}.tips.${i}`;
    const tip = dict[key as keyof typeof dict] || TRANSLATIONS['en'][key as keyof typeof TRANSLATIONS['en']];
    if (tip && tip !== key) tips.push(tip);
  }
  if (tips.length === 0) {
    tips.push(
      dict['tool.default.tips.1' as keyof typeof dict] || 'Preview your output before downloading.',
      dict['tool.default.tips.2' as keyof typeof dict] || 'All processing happens locally for maximum privacy.',
      dict['tool.default.tips.3' as keyof typeof dict] || 'Use custom output naming to keep files organized.'
    );
  }
  title = `${translatedName} - TacoPDF`;
} else if (isStaticPage) {
  let pageTitleStr = slug.charAt(0).toUpperCase() + slug.slice(1);
  if (slug === 'faq') pageTitleStr = 'FAQ';
  if (slug === 'sitemap') pageTitleStr = 'Sitemap';
  if (pageType) {
      if (pageType === 'how') pageTitleStr = dict['page.how.title' as keyof typeof dict] || 'How It Works';
      else if (pageType === 'about') pageTitleStr = dict['page.about.title' as keyof typeof dict] || 'About Us';
      else if (pageType === 'retention') pageTitleStr = dict['page.retention.title' as keyof typeof dict] || 'Data Retention Policy';
      else pageTitleStr = dict[`footer.${pageType}` as keyof typeof dict] || pageTitleStr;
  }
  title = `${pageTitleStr} - TacoPDF`;
  translatedDescription = dict['footer.desc' as keyof typeof dict] || 'Free & Secure Online PDF Tools';
}

const breadcrumbsSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": dict['home.title' as keyof typeof dict]?.split(' - ')[0] || "Home",
      "item": `https://tacopdf.com${lang === 'en' ? '' : `/${lang}`}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": dict['nav.tools' as keyof typeof dict] || "PDF Tools",
      "item": `https://tacopdf.com${lang === 'en' ? '' : `/${lang}`}/#beranda-bawah`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": translatedName,
      "item": `https://tacopdf.com${lang === 'en' ? '' : `/${lang}`}/${slug}`
    }
  ]
});

---

<BaseLayout title={title} description={translatedDescription} lang={lang}>
  {isStaticPage ? (
    slug === 'faq' ? (
      <div class="flex-1 w-full bg-background animate-fade-in pb-12">
        <FAQSection client:load initialLang={lang} />
      </div>
    ) : slug === 'sitemap' ? (
      <div class="flex-1 w-full bg-background animate-fade-in p-8 text-center text-on-surface">
        <h1 class="text-3xl font-bold mb-4">Sitemap</h1>
        <p>Sitemap is auto-generated by Astro integrations.</p>
      </div>
    ) : (
      <StaticPageClient pageType={pageType as any} client:load initialLang={lang} />
    )
  ) : (
    <div class="flex flex-col w-full bg-background text-on-surface min-h-screen">
      {!isStaticPage && <script type="application/ld+json" set:html={breadcrumbsSchema} />}
      <div id="workspace-top" class="max-w-[1200px] mx-auto px-4 md:px-8 py-8 md:py-12 scroll-mt-24 w-full">
        {/* Breadcrumbs */}
        <nav class="flex items-center text-xs md:text-sm font-medium text-on-surface-variant mb-6 space-x-2" aria-label="Breadcrumb">
          <a href={lang === 'en' ? '/' : `/${lang}`} class="hover:text-primary transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="hidden sm:inline">{dict['home.title' as keyof typeof dict]?.split(' - ')[0] || 'TacoPDF'}</span>
          </a>
          <span class="text-outline-variant/60">/</span>
          <a href={lang === 'en' ? '/#beranda-bawah' : `/${lang}/#beranda-bawah`} class="hover:text-primary transition-colors">
            {dict['nav.tools' as keyof typeof dict] || 'PDF Tools'}
          </a>
          <span class="text-outline-variant/60">/</span>
          <span class="text-primary truncate" aria-current="page">
            {translatedName}
          </span>
        </nav>

        {/* Tool Header Card */}
        <div class="mb-8 p-6 lg:p-8 bg-surface-container border border-outline-variant/30 rounded-2xl shadow-sm flex flex-col md:flex-row gap-5 md:gap-8 items-start md:items-center">
           <div class="bg-surface-container-high p-4 rounded-xl border border-outline-variant/50 shrink-0 shadow-inner">
             <TacoIcon name={tool!.icon} size={56} className="text-primary-container" />
           </div>
           <div>
             <h1 class="text-2xl md:text-3xl lg:text-4xl font-black text-on-surface mb-2 md:mb-3 tracking-tight">
               {translatedName}
             </h1>
             <p class="text-base md:text-lg text-on-surface-variant leading-relaxed max-w-3xl">
               {translatedDescription}
             </p>
           </div>
        </div>

        <WorkspaceWrapper tool={tool!} lang={lang} client:only="react" />
        
        <div class="mt-12 border border-outline-variant bg-surface-container rounded-2xl p-6 md:p-8 space-y-6">
          <h2 class="text-xl font-bold text-primary-container flex items-center gap-2 border-b border-outline-variant pb-3">
            <TacoIcon name="help-circle" size={22} className="text-primary-container" />
            {dict['workspace.how_to_use' as keyof typeof dict] || 'How to Use'} - {translatedName}
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-on-surface-variant text-sm leading-relaxed">
            <div class="space-y-4">
              <h3 class="font-bold text-on-surface text-base flex items-center gap-2">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary-container/10 border border-primary-container/30 text-primary text-xs font-mono font-bold">1</span>
                {dict['workspace.how_to_title' as keyof typeof dict] || 'Instructions for'} {translatedName}
              </h3>
              <ol class="list-decimal pl-5 space-y-2.5">
                {howToSteps.map((step, idx) => (
                  <li class="marker:text-primary-container marker:font-bold">
                    {step}
                  </li>
                ))}
              </ol>
            </div>

            <div class="space-y-4">
              <h3 class="font-bold text-on-surface text-base flex items-center gap-2">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary-container/10 border border-primary-container/30 text-primary text-xs font-mono font-bold">2</span>
                {dict['workspace.tips_title' as keyof typeof dict] || 'Professional Tips'}
              </h3>
              <ul class="list-disc pl-5 space-y-2.5">
                {tips.map((tip, idx) => (
                  <li class="marker:text-primary-container">
                    {tip}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <ToolSeoArticle toolId={tool!.id} lang={lang} />
      </div>
    </div>
  )}
</BaseLayout>
