---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePageClient from '../components/HomePageClient';
import { TRANSLATIONS } from '../data/translations';

const lang = 'en';
const dict = TRANSLATIONS[lang as keyof typeof TRANSLATIONS] || TRANSLATIONS['en'];
const baseTitle = dict['home.title' as keyof typeof dict] || 'Manage PDF Files Fast, Free & Secure';
const title = `${baseTitle} | TacoPDF`;
const description = dict['home.subtitle' as keyof typeof dict] || 'Process documents directly in your browser. Total privacy with zero file storage.';
---

<BaseLayout title={title} description={description} lang={lang}>
  <HomePageClient lang={lang} client:load />
</BaseLayout>

