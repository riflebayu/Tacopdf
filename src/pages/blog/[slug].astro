---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Calendar, User, ArrowLeft, Tag } from 'lucide-react';
import { TRANSLATIONS } from '../../data/translations';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => {
    return id.startsWith('en/') || id.startsWith('en\\');
  });
  
  return posts.map(post => ({
    params: { slug: post.id.split(/[\/\\]/)[1] },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = 'en';
const dict = TRANSLATIONS[lang as keyof typeof TRANSLATIONS] || TRANSLATIONS['en'];
---

<BaseLayout title={`${post.data.title} | TacoPDF`} description={post.data.description} lang={lang}>
  <article class="min-h-screen bg-background pt-16 md:pt-24 pb-20 selection:bg-primary/30">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      
      {/* Back Button */}
      <a href="/blog" class="inline-flex items-center gap-2 text-primary hover:text-on-primary-container font-semibold mb-4 md:mb-6 transition-colors">
        <ArrowLeft class="w-4 h-4" /> Back to Blog
      </a>

      {/* Header */}
      <header class="mb-8 md:mb-12">
        {/* 1. Primary Category Badge */}
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mb-3">
            <span class="inline-block bg-primary/10 text-primary border border-primary/20 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">
              {post.data.tags[0]}
            </span>
          </div>
        )}

        {/* 2. Main Title */}
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-on-surface mb-6 leading-tight">
          {post.data.title}
        </h1>

        {/* 3. Metadata (Author & Date) */}
        <div class="flex flex-wrap items-center gap-3 text-sm md:text-base font-medium text-on-surface-variant">
          <div class="flex items-center gap-1.5">
            <User class="w-4 h-4 md:w-5 md:h-5" />
            <span>{post.data.author}</span>
          </div>
          <span class="text-on-surface-variant/40">•</span>
          <div class="flex items-center gap-1.5">
            <Calendar class="w-4 h-4 md:w-5 md:h-5" />
            <time dateTime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })}
            </time>
          </div>
        </div>
      </header>

      {/* Featured Image */}
      {post.data.featuredImage && (
        <div class="relative w-full rounded-xl md:rounded-3xl mb-8 md:mb-16 shadow-2xl border border-outline flex justify-center bg-surface-container-lowest">
          <img 
            src={post.data.featuredImage} 
            alt={post.data.title}
            class="w-full h-auto object-contain rounded-xl md:rounded-3xl max-h-[600px]"
          />
        </div>
      )}

      {/* Markdown Content */}
      <article class="prose max-w-none mx-auto lg:prose-lg dark:prose-invert prose-img:rounded-xl md:prose-img:rounded-2xl prose-img:w-full prose-img:h-auto prose-img:object-contain prose-p:text-[17px] prose-p:leading-relaxed md:prose-p:text-lg">
        <Content />
      </article>

      {/* Tags Footer Section */}
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-outline-variant/30">
          <div class="flex items-center gap-2 mb-3 text-sm font-semibold text-on-surface-variant">
            <Tag class="w-4 h-4 text-primary" />
            <span>Related Topics:</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="bg-surface-container-high border border-outline-variant px-3 py-1.5 rounded-xl text-xs font-medium text-on-surface hover:border-primary/50 transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

    </div>
  </article>
</BaseLayout>
