---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Calendar, User, ArrowLeft, Tag } from 'lucide-react';
import { TRANSLATIONS } from '../../data/translations';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => {
    return id.startsWith('en/') || id.startsWith('en\\');
  });
  
  return posts.map(post => ({
    params: { slug: post.id.split(/[\/\\]/)[1] },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = 'en';
const dict = TRANSLATIONS[lang as keyof typeof TRANSLATIONS] || TRANSLATIONS['en'];
---

<BaseLayout title={`${post.data.title} | TacoPDF`} description={post.data.description} lang={lang}>
  <article class="min-h-screen bg-background pt-24 pb-20 selection:bg-primary/30">
    <div class="max-w-4xl mx-auto px-6">
      
      {/* Back Button */}
      <a href="/blog" class="inline-flex items-center gap-2 text-primary hover:text-on-primary-container font-semibold mb-8 transition-colors">
        <ArrowLeft class="w-4 h-4" /> Back to Blog
      </a>

      {/* Header */}
      <header class="mb-12">
        <div class="flex flex-wrap items-center gap-4 text-sm font-medium text-on-surface-variant mb-6">
          <div class="flex items-center gap-1.5">
            <Calendar class="w-4 h-4 text-primary" />
            <time dateTime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })}
            </time>
          </div>
          <div class="flex items-center gap-1.5">
            <User class="w-4 h-4 text-primary" />
            <span>{post.data.author}</span>
          </div>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-on-surface mb-6 leading-tight">
          {post.data.title}
        </h1>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {post.data.tags.map(tag => (
              <span class="inline-flex items-center gap-1 bg-surface-container border border-outline px-3 py-1 rounded-full text-xs font-semibold text-on-surface">
                <Tag class="w-3 h-3 text-primary" /> {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      {/* Featured Image */}
      {post.data.featuredImage && (
        <div class="relative aspect-[21/9] w-full rounded-3xl overflow-hidden mb-16 shadow-2xl border border-outline">
          <img 
            src={post.data.featuredImage} 
            alt={post.data.title}
            class="w-full h-auto object-contain rounded-lg"
          />
        </div>
      )}

      {/* Markdown Content */}
      <article class="prose max-w-none mx-auto lg:prose-lg dark:prose-invert prose-img:rounded-xl prose-img:w-full prose-img:h-auto prose-img:object-contain">
        <Content />
      </article>

    </div>
  </article>
</BaseLayout>
