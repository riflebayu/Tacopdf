---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import MaintenancePopup from '../components/MaintenancePopup';

interface HreflangLink {
  lang: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  author?: string; // [SEO FIX: Dynamic E-E-A-T Author Identity]
  schema?: string; // [SEO FIX: Dynamic Schema]
  image?: string; // [SEO FIX: Open Graph / Social Image]
  ogType?: string; // [SEO FIX: Open Graph Type (website vs article)]
  disableHreflang?: boolean; // [SEO FIX: Decouple standalone blog posts]
  customHreflang?: HreflangLink[]; // [SEO FIX: Explicit verified translation cluster]
}

const { 
  title = "TacoPDF", 
  description = "Free & Secure Online PDF Tools", 
  lang = "en",
  author = "Muhammad Bayu Edi",
  schema,
  image,
  ogType = "website",
  disableHreflang = false,
  customHreflang
} = Astro.props;

// [SEO FIX: Canonical URL Consistency] Remove trailing slash for exact matching
let currentPath = Astro.url.pathname;
if (currentPath.endsWith('/') && currentPath.length > 1) {
  currentPath = currentPath.slice(0, -1);
}

const canonicalUrl = `https://tacopdf.com${currentPath === '/' ? '' : currentPath}`;

// [SEO FIX: Dynamic Hreflang Injection]
const supportedLangs = ['en', 'id', 'es', 'fr', 'de', 'pt', 'ja'];
let basePath = currentPath;
if (lang !== 'en') {
  basePath = currentPath.replace(new RegExp(`^/${lang}`), '') || '/';
}

const defaultHreflangLinks: HreflangLink[] = supportedLangs.map((l) => {
  let url = 'https://tacopdf.com';
  if (l === 'en') {
    url += basePath === '/' ? '' : basePath;
  } else {
    url += `/${l}${basePath === '/' ? '' : basePath}`;
  }
  return { lang: l, url };
});

const finalHreflangLinks: HreflangLink[] = disableHreflang
  ? []
  : (customHreflang && customHreflang.length > 0 ? customHreflang : defaultHreflangLinks);

const defaultUrl = finalHreflangLinks.find(link => link.lang === 'en')?.url || finalHreflangLinks[0]?.url || 'https://tacopdf.com';

// [SEO FIX: Social Image absolute URL]
const ogImageUrl = image 
  ? (image.startsWith('http') ? image : `https://tacopdf.com${image.startsWith('/') ? image : `/${image}`}`)
  : 'https://tacopdf.com/favicon-192x192.png';

// [SEO FIX: Dynamic Schema] Fallback to Homepage WebApplication schema
const finalSchema = schema || JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "TacoPDF",
  "url": "https://tacopdf.com",
  "description": "Secure, fast, and 100% free client-side PDF utility. Merge, split, compress, rotate, and edit PDF files directly in your browser — no uploads, no registration, no watermark.",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript and WebAssembly support.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "creator": {
    "@type": "Person",
    "name": "Muhammad Bayu Edi",
    "url": "https://www.instagram.com/bay.lightyear/",
    "sameAs": [
      "https://facebook.com/baylightyear04/",
      "https://www.instagram.com/bay.lightyear/"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "TacoPDF",
    "url": "https://tacopdf.com"
  }
});
---
<html lang={lang} style="background-color: #17130a; color: #ece1d1;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Google AdSense Account Verification */}
    <meta name="google-adsense-account" content="ca-pub-9178424383165717" />
    {/* Google Search Console Verification */}
    <meta name="google-site-verification" content="0ZbJDYi7NVs8YR1pzNmtuJXNLhlO55uVEorSPZp5E60" />
    {/* Google Search SEO-Compliant Favicons */}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="TacoPDF" />

    {/* [SEO FIX: Pillar 2] Cleaned Canonical URL */}
    <link rel="canonical" href={canonicalUrl} />

    {/* [SEO FIX: Pillar 1] Bidirectional Hreflang Tags */}
    {!disableHreflang && finalHreflangLinks.length > 0 && (
      <>
        {finalHreflangLinks.map((link) => (
          <link rel="alternate" hreflang={link.lang} href={link.url} />
        ))}
        <link rel="alternate" hreflang="x-default" href={defaultUrl} />
      </>
    )}

    {/* [SEO FIX: Open Graph & Social Cards] */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="TacoPDF" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    {/* [SEO FIX: Twitter Card Tags] */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Google AdSense */}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9178424383165717" crossorigin="anonymous"></script>

    {/* E-E-A-T Author & Trust Signals — readable by all bots from raw HTML */}
    <meta name="author" content={author} />
    <meta name="creator" content={author} />
    <meta name="publisher" content="TacoPDF" />
    <meta property="article:author" content={author} />

    {/* Social Links for Personal Entity Verification */}
    <link rel="me" href="https://facebook.com/baylightyear04/" />
    <link rel="me" href="https://www.instagram.com/bay.lightyear/" />

    {/* [SEO FIX: Pillar 4] Dynamic JSON-LD Schema */}
    <script type="application/ld+json" set:html={finalSchema} />

    <GoogleAnalytics />
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="antialiased text-on-surface bg-background min-h-screen flex flex-col" style="background-color: #17130a; color: #ece1d1;">
    <div class="flex-1 w-full flex flex-col overflow-x-hidden">
      <Navbar client:load initialLang={lang} currentPath={currentPath} />
      
      <div class="flex-1 w-full flex flex-col">
        <slot />
      </div>

      <Footer client:load initialLang={lang} currentPath={currentPath} />
      <MaintenancePopup client:idle initialLang={lang} />
    </div>

    {/* Adsterra Social Bar */}
    <script is:inline src="https://pl30966008.profitableratecpmnetwork.com/d2/26/cb/d226cbb7d5a5e95295336bdbee88ed30.js"></script>
  </body>
</html>
