---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title = "TacoPDF", description = "Free & Secure Online PDF Tools", lang = "en" } = Astro.props;
---
<html lang={lang} style="background-color: #17130a; color: #ece1d1;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="apple-touch-icon" href="/logo.png" />

    {/* E-E-A-T Author & Trust Signals — readable by all bots from raw HTML */}
    <meta name="author" content="Muhammad Bayu Edi" />
    <meta name="creator" content="Muhammad Bayu Edi" />
    <meta name="publisher" content="TacoPDF" />
    <meta property="og:site_name" content="TacoPDF" />
    <meta property="article:author" content="Muhammad Bayu Edi" />

    {/* Social Links for Trust Signals */}
    <link rel="me" href="https://www.instagram.com/riflebayu" />
    <link rel="me" href="https://www.facebook.com/profile.php?id=100004429534685" />

    {/* WebApplication Schema — readable by Google crawler from raw HTML */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "TacoPDF",
      "url": "https://tacopdf.com",
      "description": "Secure, fast, and 100% free client-side PDF utility. Merge, split, compress, rotate, and edit PDF files directly in your browser — no uploads, no registration, no watermark.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and WebAssembly support.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "creator": {
        "@type": "Person",
        "name": "Muhammad Bayu Edi",
        "url": "https://www.instagram.com/riflebayu",
        "sameAs": [
          "https://github.com/riflebayu",
          "https://www.facebook.com/profile.php?id=100004429534685"
        ]
      },
      "publisher": {
        "@type": "Organization",
        "name": "TacoPDF",
        "url": "https://tacopdf.com"
      }
    })} />

    <GoogleAnalytics />
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="antialiased text-on-surface bg-background min-h-screen flex flex-col" style="background-color: #17130a; color: #ece1d1;">
    <div class="flex-1 w-full flex flex-col overflow-x-hidden">
      <Navbar client:load initialLang={lang} currentPath={Astro.url.pathname} />
      
      <div class="flex-1 w-full flex flex-col">
        <slot />
      </div>

      <Footer client:load initialLang={lang} currentPath={Astro.url.pathname} />
    </div>
  </body>
</html>
