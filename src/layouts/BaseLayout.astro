---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title = "TacoPDF", description = "Free & Secure Online PDF Tools", lang = "en" } = Astro.props;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="antialiased text-on-surface bg-background overflow-x-hidden min-h-screen flex flex-col">
    <Navbar client:load initialLang={lang} />
    
    <div class="flex-1 w-full flex flex-col">
      <slot />
    </div>

    <Footer client:load initialLang={lang} />
  </body>
</html>
